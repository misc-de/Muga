<?xml version="1.0" encoding="UTF-8"?>
<components version="0.8" origin="flatpak">
  <component type="desktop-application">
    <id>io.github.miscde.Muga</id>
    <name>Muga</name>
    <summary>Browse photos and videos</summary>
    <project_license>MIT</project_license>
    <description>
      <p>
      Muga is a GTK 4 and libadwaita photo gallery for Linux desktops and
      phones. It indexes local media folders, shows cached thumbnails, plays
      videos, edits photos, connects to Nextcloud Photos, and includes a
      camera for photo and video capture.
    </p>
      <p>
      On Halium and gst-droid based phones such as FuriOS devices, Muga can
      use the device camera HAL directly for flash, video light, orientation,
      and geotagging workflows.
    </p>
    </description>
    <developer id="io.github.miscde">
