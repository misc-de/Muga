    <releases>
      <release type="stable" version="0.3.1" timestamp="1787529600">
        <description>
          <p>Fixes: paging through photos follows the picture when the screen is
        rotated. Holding the phone sideways used to turn the pages with an up
        and down swipe; left and right works again.</p>
          <p>Packaging: the translations are compiled during the install, and the
        desktop entry starts the installed launcher.</p>
        </description>
      </release>
      <release type="stable" version="0.3.0" timestamp="1787270400">
        <description>
          <p>Reliability: rotating or moving a photo can no longer damage or
        overwrite it, a hand-edited settings file or a damaged media index no
        longer stops the app from starting, and an interrupted update rolls
        itself back.</p>
          <p>Fixes: cameras reporting a resolution range (libcamera) are found
        again, large libraries no longer load in full before the first frame,
        oversized images are refused before they exhaust memory, and rotated
        controls are laid out correctly.</p>
        </description>
      </release>
      <release type="stable" version="0.2.0" timestamp="1780531200">
        <description>
          <p>Performance: off-thread thumbnail and image decoding, smoother
        scrolling and swiping, faster re-scans (unchanged files are skipped),
        EXIF search via the full-text index, and lighter settings/sync work.</p>
        </description>
      </release>
      <release type="stable" version="0.1.0" timestamp="1778716800"/>
    </releases>
    <content_rating type="oars-1.1"/>
    <bundle type="flatpak" runtime="org.gnome.Platform/x86_64/49" sdk="org.gnome.Sdk/x86_64/49">app/io.github.miscde.Muga/x86_64/master</bundle>
